generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["demenag"]
}

enum RoleUtilisateur {
  client
  administrateur @map("admin")
  chauffeur      @map("driver")

  @@map("Role")
  @@schema("demenag")
}

enum StatutReservation {
  en_attente @map("pending")
  confirmee  @map("confirmed")
  en_cours   @map("in_progress")
  terminee   @map("completed")
  annulee    @map("cancelled")

  @@map("BookingStatus")
  @@schema("demenag")
}

model Utilisateur {
  id                                String             @id @default(uuid()) @db.Uuid
  nom                               String             @map("name")
  telephone                         String             @unique @map("phone")
  email                             String?            @unique @map("email")
  empreinteMotDePasse               String             @map("password_hash")
  demandeReinitialisationMotDePasse DateTime?          @map("password_reset_requested_at") @db.Timestamptz
  role                              RoleUtilisateur    @default(client)
  photo                             String?            @map("photo")
  creeLe                            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  actif                             Boolean            @default(true) @map("active")
  sessions                          SessionConnexion[]
  reservations                      Reservation[]
  profilChauffeur                   Chauffeur?
  notifications                     Notification[]

  @@map("users")
  @@schema("demenag")
}

model SessionConnexion {
  empreinteJeton String      @id @map("token_hash")
  utilisateurId  String      @map("user_id") @db.Uuid
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe       DateTime    @map("expires_at") @db.Timestamptz

  @@index([expireLe])
  @@map("sessions")
  @@schema("demenag")
}

model Vehicule {
  id                  String             @id
  nom                 String             @map("name")
  nomCourt            String             @default("") @map("short_name")
  volume              String
  longueur            String             @map("length")
  hauteur             String             @map("height")
  largeur             String             @map("width")
  largeurPassageRoues String             @map("wheel_width")
  image               String
  interieur           String             @map("interior")
  actif               Boolean            @default(true) @map("active")
  tarifs              Int[]              @map("prices")
  reservations        Reservation[]
  chauffeurs          Chauffeur[]
  controlesVehicule   ControleVehicule[]
  signalementsPanne   SignalementPanne[]

  @@map("vehicles")
  @@schema("demenag")
}

model Chauffeur {
  id                 String             @id @default(uuid()) @db.Uuid
  utilisateurId      String?            @unique @map("user_id") @db.Uuid
  utilisateur        Utilisateur?       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nom                String             @map("name")
  telephone          String             @unique @map("phone")
  photo              String?            @map("photo")
  actif              Boolean            @default(true) @map("active")
  fonction           String             @default("chauffeur") @map("role")
  vehiculeId         String?            @map("vehicle_id")
  disponibilites     Json               @default("[]") @map("availability")
  vehiculesAutorises Json               @default("[]") @map("authorized_vehicles")
  adresse            String             @default("") @map("address")
  latitude           Float?
  longitude          Float?
  adresseGeocodee    String?            @map("geocoded_address")
  competences        Json               @default("[]") @map("tags")
  notes              String             @default("")
  refusMissions      Json               @default("[]") @map("mission_refusals")
  refusEffaces       Int                @default(0) @map("cleared_refusals")
  vehicule           Vehicule?          @relation(fields: [vehiculeId], references: [id], onDelete: SetNull)
  reservations       Reservation[]
  controlesVehicule  ControleVehicule[]
  signalementsPanne  SignalementPanne[]

  @@index([vehiculeId])
  @@map("drivers")
  @@schema("demenag")
}

model ControleVehicule {
  id           String    @id @default(uuid()) @db.Uuid
  chauffeurId  String    @map("driver_id") @db.Uuid
  chauffeur    Chauffeur @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  vehiculeId   String    @map("vehicle_id")
  vehicule     Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Restrict)
  dateControle DateTime  @map("inspection_date") @db.Date
  niveaux      Json      @map("levels")
  etatVehicule String    @map("vehicle_condition")
  observations String
  photos       Json
  creeLe       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([chauffeurId, dateControle])
  @@index([dateControle, creeLe])
  @@map("vehicle_inspections")
  @@schema("demenag")
}

model SignalementPanne {
  id          String    @id @default(uuid()) @db.Uuid
  chauffeurId String    @map("driver_id") @db.Uuid
  chauffeur   Chauffeur @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  vehiculeId  String    @map("vehicle_id")
  vehicule    Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Restrict)
  description String
  latitude    Float
  longitude   Float
  precision   Float?    @map("accuracy_meters")
  photos      Json
  statut      String    @default("nouveau") @map("status")
  creeLe      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([statut, creeLe])
  @@map("breakdown_reports")
  @@schema("demenag")
}

model ParametreApplication {
  id                            String  @id @default("main")
  tarifManoeuvre                Int     @map("labour_price")
  tarifEtageManoeuvre           Int     @default(500) @map("labour_floor_price")
  tarifAscenseurManoeuvre       Int     @default(500) @map("labour_lift_price")
  grillePrixManoeuvre           Json    @default("{}") @map("labour_price_matrix")
  planificationManoeuvre        Json    @default("{}") @map("moving_labor_planning")
  tarifMontage                  Int     @map("assembly_price")
  grillePrixMontage             Json    @default("{}") @map("assembly_price_matrix")
  telephoneEntreprise           String  @map("business_phone")
  numeroWhatsapp                String  @default("+221775105104") @map("whatsapp_phone")
  indicatifWhatsapp             String  @default("221") @map("whatsapp_country_code")
  modeWhatsapp                  String  @default("api") @map("whatsapp_mode")
  modeleDevisWhatsapp           String  @default("Bonjour {nom},\n\nVoici votre devis final Demenag Express n° {num} :\n- Date : {date}{heure}\n- Trajet : {trajet}\n- Véhicule : {vehicule}, {voyages}\n- Montant total : {total}\n\nCe montant est définitif.\nJe vous envoie le PDF du devis final juste après ce message.\n\nMerci pour votre confiance.") @map("whatsapp_quote_template")
  modeleDevisProvisoireWhatsapp String  @default("Bonjour {nom},\n\nMerci pour votre demande. Voici votre devis provisoire Demenag Express n° {num} :\n- Date : {date}{heure}\n- Trajet : {trajet}\n- Véhicule : {vehicule}, {voyages}\n- Montant estimé : {total}\n\nCe montant est une estimation établie d’après votre inventaire. Il sera confirmé par le devis final.\nJe vous envoie le PDF du devis juste après ce message.\n\nPour confirmer ou modifier votre demande, répondez simplement ici.") @map("whatsapp_provisional_template")
  modelePrenomContactWhatsapp     String  @default("{ref} {prenom}") @map("contact_first_template")
  modeleNomContactWhatsapp        String  @default("{nom} · {date}") @map("contact_last_template")
  nomEntreprise                 String  @default("Demenag Express") @map("business_name")
  adresseEntreprise             String  @default("Dakar, Sénégal") @map("business_address")
  emailEntreprise               String  @default("") @map("business_email")
  nineaEntreprise               String  @default("") @map("business_ninea")
  rccmEntreprise                String  @default("") @map("business_rccm")
  validiteDevisJours            Int     @default(15) @map("quote_validity_days")
  acompteReservationPct         Int     @default(0) @map("booking_deposit_percent")
  conditionsDevis               String  @default("Validité : ce devis est valable 30 jours à compter de sa date d’émission.\nRéservation : la date est réservée dès l’acceptation du devis par le client (signature ou confirmation écrite, WhatsApp compris).\nPaiement : le montant est réglé à la fin du déménagement, selon le mode de paiement indiqué sur le devis.\nReport ou annulation : toute demande de report ou d’annulation doit être signalée au moins 48 heures avant la date prévue.\nPréparation : le client veille à ce que ses affaires soient prêtes à charger à l’arrivée de l’équipe et à garantir l’accès (stationnement, ascenseur, clés).\nInventaire : le prix est établi d’après l’inventaire déclaré. Tout objet ou volume supplémentaire, ou tout dépassement du temps prévu, peut entraîner un ajustement du devis final.\nObjets de valeur : bijoux, argent, documents et objets précieux restent sous la garde du client.\nRéserves : toute réserve sur l’état des biens doit être signalée à l’équipe avant son départ. Les cartons fermés par le client voyagent sous sa responsabilité.\nLocation avec chauffeur : les manœuvres sont fournis et encadrés par le client. Demenag Express répond du véhicule, du chauffeur et du matériel fourni.") @map("quote_terms")
  conditionsDevisActives         Boolean @default(true) @map("quote_terms_enabled")
  cleApiGoogleMaps               String  @default("") @map("google_maps_api_key")
  tarifHeureLocation            Int     @default(10000) @map("rental_overtime_hourly_rate")
  materielLocation              Json    @default("[]") @map("rental_kit_configuration")
  piedFacture                   String  @default("Merci pour votre confiance.") @map("invoice_footer")
  tiktokUrl                     String? @map("tiktok_url")
  facebookUrl                   String? @map("facebook_url")
  instagramUrl                  String? @map("instagram_url")
  logoFacture                   String? @map("invoice_logo")
  tamponFacture                 String? @map("invoice_stamp")
  signatureFacture              String? @map("invoice_signature")
  paiementWave                  Boolean @default(true) @map("payment_wave")
  paiementEspeces               Boolean @default(true) @map("payment_cash")
  qrPaiement                    String? @default("/assets/wave-qr.png") @map("payment_qr")

  reservationsOuvertes      Boolean @default(true) @map("bookings_enabled")
  delaiMaximumJours         Int     @default(366) @map("max_advance_days")
  preavisReservationHeures  Int     @default(0) @map("min_notice_hours")
  quantiteMaximaleOptions   Int     @default(20) @map("max_options")
  nombreMaximalTrajets      Int     @default(20) @map("max_trips")
  annulationClientAutorisee Boolean @default(true) @map("client_cancellation")
  preavisAnnulationHeures   Int     @default(0) @map("cancellation_notice_hours")
  bornesDistance            Int[]   @default([15, 25, 35]) @map("distance_bounds")
  creneauxOuverts           Json    @map("enabled_slots")
  questionnaire             Json    @default("[]") @map("client_questionnaire")

  @@map("settings")
  @@schema("demenag")
}

model IllustrationInventaire {
  cle       String   @id @db.VarChar(150) @map("key")
  image     String   @db.Text
  modifieLe DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("inventory_illustrations")
  @@schema("demenag")
}

model ConfigurationClaude {
  id               String @id @default("main")
  cleChiffree      String @map("encrypted_key")
  vecteur          String @map("iv")
  etiquette        String @map("auth_tag")
  modele           String @default("") @map("model")
  modeles          Json   @default("[]") @map("models")

  @@map("claude_configuration")
  @@schema("demenag")
}

model Itineraire {
  id       String   @id @default(uuid()) @db.Uuid
  donnees  Json     @map("data")
  expireLe DateTime @map("expires_at") @db.Timestamptz

  @@index([expireLe])
  @@map("routes")
  @@schema("demenag")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  utilisateurId      String            @map("user_id") @db.Uuid
  utilisateur        Utilisateur       @relation(fields: [utilisateurId], references: [id])
  identifiantDemande String            @map("request_id") @db.Uuid
  reference          String            @unique
  vehiculeId         String            @map("vehicle_id")
  vehicule           Vehicule          @relation(fields: [vehiculeId], references: [id])
  chauffeurId        String?           @map("driver_id") @db.Uuid
  chauffeur          Chauffeur?        @relation(fields: [chauffeurId], references: [id], onDelete: SetNull)
  date               DateTime?         @db.Date
  creneau            String            @map("time_slot")
  statut             StatutReservation @default(en_attente) @map("status")
  // Instantané métier : coordonnées, prix et historique des devis figés.
  donnees            Json              @map("data")
  devis              Devis[]
  courses            Course[]
  version            Int               @default(1)
  creeLe             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  supprimeLe         DateTime?         @map("deleted_at") @db.Timestamptz

  @@unique([utilisateurId, identifiantDemande])
  @@index([utilisateurId, creeLe])
  @@index([statut, date])
  @@index([chauffeurId, date])
  @@index([supprimeLe, creeLe])
  @@map("bookings")
  @@schema("demenag")
}

model Course {
  id              String      @id @default(uuid()) @db.Uuid
  reservationId   String      @map("booking_id") @db.Uuid
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sequence        Int         @map("sequence_number")
  loadingPhotos   Json        @map("loading_photos")
  unloadingPhotos Json?       @map("unloading_photos")
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz

  @@unique([reservationId, sequence])
  @@index([reservationId, sequence])
  @@map("booking_trips")
  @@schema("demenag")
}

/// Historique immutable des devis émis. Les montants sont en francs CFA.
model Devis {
  id            String       @id @db.Uuid
  reservationId String       @map("reservation_id") @db.Uuid
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reference     String       @unique
  nature        String
  montantTotal  Int?         @map("montant_total")
  remise        Int
  nombreTrajets Int          @map("nombre_trajets")
  tranche       Int
  notes         String
  creeLe        DateTime     @map("cree_le") @db.Timestamptz
  lignes        LigneDevis[]

  @@index([reservationId, creeLe])
  @@index([nature, creeLe])
  @@map("devis")
  @@schema("demenag")
}

model LigneDevis {
  id           String @id @default(uuid()) @db.Uuid
  devisId      String @map("devis_id") @db.Uuid
  devis        Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)
  libelle      String
  quantite     Int
  prixUnitaire Int    @map("prix_unitaire")
  montant      Int
  position     Int

  @@unique([devisId, position])
  @@map("lignes_devis")
  @@schema("demenag")
}

model EcritureComptable {
  id                  String    @id @default(uuid()) @db.Uuid
  type                String
  categorie           String    @map("category")
  libelle             String    @map("label")
  montant             Int       @map("amount")
  date                DateTime  @db.Date
  creeLe              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  annuleLe            DateTime? @map("voided_at") @db.Timestamptz
  sourceDevisId       String?   @map("source_quote_id") @db.Uuid
  sourceQuoteKind     String?   @map("source_quote_kind")
  sourceQuoteQuantity Int?      @map("source_quote_quantity")

  @@unique([sourceDevisId, sourceQuoteKind])
  @@index([date, annuleLe])
  @@map("accounting_entries")
  @@schema("demenag")
}

model ConfigurationComptable {
  identifiant String   @id @default("main") @map("id")
  donnees     Json     @default("{}") @map("data")
  modifieLe   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("accounting_configuration")
  @@schema("demenag")
}

model PointPeage {
  id              String   @id @default(uuid()) @db.Uuid
  nom             String   @map("name")
  region          String   @default("")
  axe             String   @default("") @map("axis")
  tarifLourd      Int      @map("heavy_price")
  tarifsVehicules Json     @default("{}") @map("vehicle_prices")
  latitude        Float?
  longitude       Float?
  creeLe          DateTime @default(now()) @map("created_at") @db.Timestamptz
  modifieLe       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("toll_points")
  @@schema("demenag")
}

model ProfilClient {
  telephoneNormalise String   @id @map("normalized_phone")
  nom                String   @map("name")
  telephone          String   @map("phone")
  adresse            String   @default("") @map("address")
  modifieLe          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("client_profiles")
  @@schema("demenag")
}

model ClientMasque {
  telephoneNormalise String   @id @map("normalized_phone")
  masqueLe           DateTime @default(now()) @map("hidden_at") @db.Timestamptz

  @@map("hidden_clients")
  @@schema("demenag")
}

model Notification {
  id            String      @id @default(uuid()) @db.Uuid
  utilisateurId String      @map("user_id") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  titre         String      @map("title")
  message       String
  reservationId String?     @map("booking_id") @db.Uuid
  lueLe         DateTime?   @map("read_at") @db.Timestamptz
  creeLe        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([utilisateurId, lueLe, creeLe])
  @@map("notifications")
  @@schema("demenag")
}
