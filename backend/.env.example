NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Production example: https://demenag-express-pro.vercel.app,https://www.demenagexpresspro.com
# URL pooled Neon, accessible uniquement au serveur. Conserver sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Maximum de connexions PostgreSQL par instance API (instances × cette valeur = plafond potentiel).
DATABASE_POOL_MAX=5
# URL directe de la même branche pour les migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Configuration cartographique ; remplacer les services publics pour un usage soutenu.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
MAPS_USER_AGENT=DemenagExpress/1.0 (contact: contact@example.com)
# À renseigner seulement pour npm run admin:create. Aucun compte par défaut.
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=
