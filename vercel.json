{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/assets/(.*)-([A-Za-z0-9_-]{8})\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://api.demenagexpresspro.com/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api.demenagexpresspro.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
